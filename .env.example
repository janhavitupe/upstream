# Copy this file to .env and fill in the values. Never commit .env.

# PayPal sandbox app: developer.paypal.com -> Apps & Credentials -> Sandbox -> Upstream
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# From the app's Webhooks section (optional until you set up webhooks)
PAYPAL_WEBHOOK_ID=

# Optional but recommended: github.com/settings/tokens (fine-grained, public repos, read-only)
GITHUB_TOKEN=

# Optional: LLM for explanations and chat. Any OpenAI-compatible API works; Groq is free:
# console.groq.com -> API Keys. Without a key, rule-based explanations are used.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

APP_BASE_URL=http://localhost:8000
INVOICER_NAME=Upstream Studio
OSS_MONTHLY_CAP=500
# SQLite file (default: data/upstream.db)
DATABASE_PATH=

# Sandbox demo recipients (from upstream-sandbox-accounts.csv)
DEMO_MAINTAINER_EMAILS=maintainer-a@personal.example.com,maintainer-b@personal.example.com,maintainer-c@personal.example.com
DEMO_CLIENT_EMAIL=acme-client@personal.example.com
# Clients the chat knows by name (sandbox personal accounts)
DEMO_CLIENTS=Acme=acme-client@personal.example.com,Globex=globex-client@personal.example.com
DEMO_HOSPITAL_EMAIL=city-hospital@business.example.com

# Optional: email retainer heads-ups automatically (e.g. Gmail: smtp.gmail.com, 587,
# your address, an app password). Without it you send them from the dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
